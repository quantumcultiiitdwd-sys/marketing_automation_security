# Copy to .env for docker compose. In production inject these from your secret manager instead.
APP_ENV=production
POSTGRES_PASSWORD=change-me
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
PUBLIC_API_URL=https://api.campaignshield.example
PUBLIC_APP_URL=https://app.campaignshield.example
DEMO_ENABLED=false
ALLOW_PRIVATE_INTEGRATION_HOSTS=false
MONITOR_INTERVAL_SECONDS=300
# Google Ads (live mode only)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
SENTRY_DSN=
# Cloudflare Turnstile on sign-in/sign-up (bot protection). Widget from dash.cloudflare.com → Turnstile.
# TURNSTILE_HOSTNAMES = the app's public hostname(s), comma-separated; never localhost in production.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=app.campaignshield.example
